# Configuração local em UTF-8. Copie para .env na raiz do projeto.
# Variáveis já definidas no ambiente do processo têm prioridade.
DEBUG=False
TIME_ZONE=America/Sao_Paulo

# Opcional: diretório de dados fora da pasta do programa.
# Sem esta variável, usa %LOCALAPPDATA%\RestauranteLocal no Windows.
# LOCAL_WEIGHING_DATA_DIR=C:/Users/seu-usuario/AppData/Local/RestauranteLocal

# Opcional: sem esta variável, usa a chave gerada por initialize_local.
# Não definir uma chave vazia nem compartilhar a chave real.
# SECRET_KEY=sua-chave-local-aleatoria
